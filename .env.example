# ─── 𝔎𝔦𝔫𝔤_𝔅𝔩𝔢𝔰𝔰 𝔗𝔢𝔠𝔥 Bot Configuration ─────────────────────────────────────────────────

# Your WhatsApp number (with country code, no + or spaces)
# Example: 233535502036
OWNER_NUMBER=your_number_here

# Bot display name
BOT_NAME=𝔎𝔦𝔫𝔤_𝔅𝔩𝔢𝔰𝔰 𝔗𝔢𝔠𝔥 Bot

# Command prefix
PREFIX=.

# Port for the status web server (Render sets this automatically — leave unset on Render)
PORT=3000

# ─── Optional API Keys (for better results) ───────────────────────────────────

# Unsplash API key for image search (get free key at unsplash.com/developers)
UNSPLASH_KEY=YOUR_UNSPLASH_KEY_HERE

# Giphy API key for GIF search (get free key at developers.giphy.com)
GIPHY_KEY=YOUR_GIPHY_KEY_HERE
